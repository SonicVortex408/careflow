      "type": "object"
    },
    "PanelInfo": {
      "additionalProperties": false,
      "properties": {
        "panel_name_raw": {
          "title": "Panel Name Raw",
          "type": "string"
        },
        "page_no": {
          "minimum": 1,
          "title": "Page No",
          "type": "integer"
        },
        "table_index": {
          "minimum": 0,
          "title": "Table Index",
          "type": "integer"
        }
      },
      "required": [
        "panel_name_raw",
        "page_no",
        "table_index"
      ],
      "title": "PanelInfo",
      "type": "object"
    },
