{
  "name": "polymarker-backend",
  "version": "1.0.0",
  "description": "PolyMarker Analytics API gateway (Express): auth, roles, reports, clinician review workflow, ai-service proxy",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "seed": "node src/scripts/seed.js",
    "lint": "node --check src/server.js && for f in $(find src test -name \"*.js\"); do node --check $f || exit 1; done",
    "migrate": "node src/scripts/migrate.js"
  },
  "keywords": [
    "polymarker",
    "express",
    "postgres",
    "clinician-review",
    "supabase"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.6",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "supertest": "^7.3.0"
  },
  "engines": {
    "node": ">=20.10"
  }
}
