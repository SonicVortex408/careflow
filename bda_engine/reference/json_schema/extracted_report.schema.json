  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "document_id": {
      "title": "Document Id",
      "type": "string"
    },
    "patient_id": {
      "title": "Patient Id",
      "type": "string"
    },
    "extraction": {
      "$ref": "#/$defs/ExtractionMeta"
    },
    "patient_context": {
      "$ref": "#/$defs/PatientContext"
    },
    "lab": {
      "$ref": "#/$defs/LabInfo"
    },
    "panels": {
      "items": {
        "$ref": "#/$defs/PanelInfo"
      },
      "title": "Panels",
      "type": "array"
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/ExtractedRow"
      },
      "title": "Rows",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "document_id",
    "patient_id",
    "extraction"
  ],
  "title": "ExtractedReport",
  "type": "object"
}
