      "additionalProperties": false,
      "properties": {
        "age_years": {
          "anyOf": [
            {
              "maximum": 130,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Age Years"
        },
        "age_confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Age Confidence"
        },
        "sex": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sex"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sex_confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sex Confidence"
        }
      },
      "title": "PatientContext",
      "type": "object"
    },
    "Sex": {
      "enum": [
        "male",
        "female",
        "unknown"
      ],
      "title": "Sex",
      "type": "string"
    }
