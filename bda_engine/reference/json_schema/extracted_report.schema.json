{
  "$defs": {
    "BBox": {
      "additionalProperties": false,
      "properties": {
        "x0": {
          "title": "X0",
          "type": "number"
        },
        "y0": {
          "title": "Y0",
          "type": "number"
        },
        "x1": {
          "title": "X1",
          "type": "number"
        },
        "y1": {
          "title": "Y1",
          "type": "number"
        }
      },
      "required": [
        "x0",
        "y0",
        "x1",
        "y1"
      ],
      "title": "BBox",
      "type": "object"
    },
    "Comparator": {
      "enum": [
        "<",
        ">",
        "=",
        "none"
      ],
      "title": "Comparator",
      "type": "string"
    },
    "ExtractedRow": {
      "additionalProperties": false,
      "description": "One biomarker occurrence, exactly as it appeared on the page.",
      "properties": {
        "row_id": {
          "title": "Row Id",
          "type": "string"
        },
        "page_no": {
          "minimum": 1,
          "title": "Page No",
          "type": "integer"
        },
        "table_index": {
          "minimum": 0,
          "title": "Table Index",
          "type": "integer"
        },
        "row_index": {
          "minimum": 0,
          "title": "Row Index",
          "type": "integer"
        },
        "analyte_name_raw": {
          "title": "Analyte Name Raw",
          "type": "string"
        },
        "value_raw": {
          "title": "Value Raw",
          "type": "string"
        },
        "value_numeric": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Numeric"
        },
        "comparator": {
          "$ref": "#/$defs/Comparator",
          "default": "none"
        },
        "is_numeric": {
          "title": "Is Numeric",
          "type": "boolean"
        },
        "unit_raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit Raw"
        },
        "reference_range_raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Range Raw"
        },
        "ref_low": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ref Low"
        },
        "ref_high": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ref High"
        },
        "ref_operator": {
          "anyOf": [
            {
              "$ref": "#/$defs/Comparator"
            },
            {
              "type": "null"
            }
          ],
          "default": null
