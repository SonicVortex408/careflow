        "flag_raw": {
          "anyOf": [
            {
              "$ref": "#/$defs/FlagRaw"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "method_raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method Raw"
        },
        "bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/BBox"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "confidence": {
          "$ref": "#/$defs/FieldConfidence"
        },
        "needs_review": {
          "default": false,
          "title": "Needs Review",
          "type": "boolean"
        }
      },
      "required": [
        "row_id",
        "page_no",
        "table_index",
        "row_index",
        "analyte_name_raw",
        "value_raw",
        "is_numeric",
        "confidence"
      ],
      "title": "ExtractedRow",
      "type": "object"
    },
    "ExtractionMeta": {
      "additionalProperties": false,
      "properties": {
        "engine": {
          "title": "Engine",
          "type": "string"
