{
  "$defs": {
    "IngestStatus": {
      "enum": [
        "uploaded",
        "queued",
        "ocr_running",
        "extracted",
        "normalized",
        "ready",
        "failed"
      ],
      "title": "IngestStatus",
      "type": "string"
    },
    "SourceChannel": {
      "enum": [
        "patient_upload",
        "synthetic",
        "bulk"
      ],
      "title": "SourceChannel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "document_id": {
      "title": "Document Id",
      "type": "string"
    },
    "patient_id": {
      "title": "Patient Id",
      "type": "string"
    },
    "sha256": {
      "maxLength": 64,
      "minLength": 64,
      "title": "Sha256",
      "type": "string"
    },
    "original_name": {
      "title": "Original Name",
      "type": "string"
    },
    "stored_uri": {
      "title": "Stored Uri",
      "type": "string"
    },
    "mime_type": {
      "title": "Mime Type",
      "type": "string"
    },
    "size_bytes": {
      "minimum": 0,
      "title": "Size Bytes",
      "type": "integer"
    },
    "page_count": {
      "minimum": 1,
      "title": "Page Count",
      "type": "integer"
    },
    "has_text_layer": {
      "title": "Has Text Layer",
      "type": "boolean"
    },
    "source_channel": {
      "$ref": "#/$defs/SourceChannel"
    },
    "is_synthetic": {
      "default": false,
      "title": "Is Synthetic",
      "type": "boolean"
    },
    "ingest_status": {
      "$ref": "#/$defs/IngestStatus",
      "default": "uploaded"
    },
    "job_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Job Id"
    },
    "ocr_engine": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ocr Engine"
    },
    "ocr_engine_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ocr Engine Version"
    },
    "ingest_date": {
      "format": "date",
      "title": "Ingest Date",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "error_message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Message"
    }
  },
  "required": [
    "document_id",
    "patient_id",
    "sha256",
    "original_name",
    "stored_uri",
    "mime_type",
    "size_bytes",
    "page_count",
    "has_text_layer",
    "source_channel",
    "ingest_date",
    "created_at",
    "updated_at"
  ],
  "title": "RawDocument",
  "type": "object"
}
