        "engine_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Engine Version"
        },
        "layout_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Layout Model"
        },
        "duration_ms": {
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "pages": {
          "items": {
            "$ref": "#/$defs/PageInfo"
          },
          "title": "Pages",
          "type": "array"
        }
      },
      "required": [
        "engine",
        "duration_ms"
      ],
      "title": "ExtractionMeta",
      "type": "object"
    },
    "FieldConfidence": {
      "additionalProperties": false,
      "properties": {
        "analyte": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Analyte",
          "type": "number"
        },
        "value": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Unit",
          "type": "number"
        },
        "range": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Range",
          "type": "number"
        }
      },
      "required": [
        "analyte",
        "value",
        "unit",
        "range"
      ],
      "title": "FieldConfidence",
      "type": "object"
    },
    "FlagRaw": {
      "enum": [
        "H",
        "L",
        "N"
      ],
      "title": "FlagRaw",
      "type": "string"
    },
