# Root .env for docker compose. Each service also has its own .env.example for running outside compose.
JWT_SECRET=change-me-to-a-long-random-string
AI_INTERNAL_KEY=change-me-shared-secret
NEO4J_PASSWORD=polymarker-dev

# Optional LLM (without a key, summaries use the deterministic template)
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
GOOGLE_API_KEY=

OCR_ENGINE=tesseract
ENABLE_LAYOUTLMV3=false

# Frontend build-time API base URL
VITE_API_BASE_URL=http://localhost:5000/api

# bda_engine (profile "ml")
ETL_ENGINE=spark
SYNTHETIC_SEED=42

# Demo accounts created by the "seed" service
SEED_ADMIN_EMAIL=admin@polymarker.local
SEED_ADMIN_PASSWORD=admin-demo-pass
SEED_CLINICIAN_EMAIL=clinician@polymarker.local
SEED_CLINICIAN_PASSWORD=clinician-demo-pass
SEED_PATIENT_EMAIL=patient@polymarker.local
SEED_PATIENT_PASSWORD=patient-demo-pass
