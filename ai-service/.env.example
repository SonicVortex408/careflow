# --- HTTP
PORT=8080
CORS_ORIGINS=http://localhost:5173
# Shared secret; the backend sends it as X-Internal-Key. Leave empty only for local dev.
INTERNAL_API_KEY=

# --- LLM (optional; without a key summaries use the deterministic template)
# groq | google | none
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
GOOGLE_API_KEY=
MAX_REGENERATIONS=2

# --- Jobs / conversation memory
# celery | modal (set by deploy/modal_app.py) | local (in-process thread pool, dev only)
JOB_BACKEND=celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
# auto | redis | memory   (redis needs Redis Stack modules: RedisJSON + RediSearch)
CHECKPOINTER=auto

# --- Knowledge graph (in-memory fallback when unset or unreachable)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- OCR feature flags
# tesseract | paddle (paddle needs polymarker-common[paddle])
OCR_ENGINE=tesseract
ENABLE_LAYOUTLMV3=false

# --- Artifacts / storage
MODEL_ARTIFACT_DIR=../models
