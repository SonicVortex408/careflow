# Copy to .env and fill in. Nothing here is required just to start the
# service (see app/core/config.py) -- endpoints that need a given value
# fail with a clear error at request time if it's missing, not at import.

# --- LLM provider ---------------------------------------------------
# LLM_PROVIDER selects which client app/agent/nodes.py builds.
# LLM_MODEL is the provider-qualified model id passed to
# langchain's init_chat_model.
LLM_PROVIDER=groq
LLM_MODEL=groq:openai/gpt-oss-20b
GROQ_API_KEY=
# Only used when LLM_PROVIDER=google_genai
GOOGLE_API_KEY=

# --- CORS -------------------------------------------------------------
# Comma-separated list of allowed origins.
CORS_ALLOW_ORIGINS=http://localhost:5173

# --- Redis / Celery (Week 2 async ingestion queue) ---------------------
REDIS_URL=redis://localhost:6379/0
# Leave unset to derive both from REDIS_URL, as docker-compose.yml does.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# --- OCR feature flags (Week 2) ----------------------------------------
# tesseract (default, needs the system tesseract-ocr binary -- see
# README.md for install instructions) | paddle (needs the `paddle` extra)
OCR_ENGINE=tesseract
# true enables the LayoutLMv3 token-classification engine (needs the
# `layoutlm` extra: `uv sync --extra layoutlm`). Off by default -- heavy
# download, and the heuristic table reconstructor is the baseline it
# must beat before flipping this on in an environment.
ENABLE_LAYOUTLMV3=false
# Only needed on Windows / when tesseract is not on PATH.
TESSERACT_CMD=

# --- Neo4j (future GraphRAG phase, not used by Weeks 1-3) --------------
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# --- Shared with bda_engine ---------------------------------------------
MODEL_ARTIFACT_DIR=
